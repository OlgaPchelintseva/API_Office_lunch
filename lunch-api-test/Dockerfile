# Прописываем образ 
FROM node:20-alpine

# Настраиваем рабочую дирректорию
WORKDIR /app

# Зависимости * - все, что после package нам содходит, чтобы несколько файлов вставить
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь код в дирректорию докера
COPY . .

# Открываем порт
EXPOSE 3000

# Выполнение при старте 0.0.0.0 - хост не локальный, а в рамках докера
CMD ["npx", "vite", "--host", "0.0.0.0", "-port", "3000"]