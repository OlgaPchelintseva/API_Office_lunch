# Какой образ мы используем
FROM python:3.11-slim

# Настройка рабочей дирректории внутри контейнера 
WORKDIR /app

# Что мы копируем в контейнер и куда
COPY requirements.txt .

# Устанавливаем зависимости (RUN-запускает операцию) --no-cache-dir - облегчит вес образа, быстрее будет устанавливаться и запускаться
RUN pip install --no-cache-dir -r requirements.txt

# Копируем все файлы из корня папки
COPY . . 

# Открываем порт для работы FastAPI
EXPOSE 8000

# Выполнение при старте контейнера (CMD)
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
